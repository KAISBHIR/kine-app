{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@kine/shared": ["../../packages/shared/src/index.ts"],
      "@kine/movement-engine": ["../../packages/movement-engine/src/index.ts"],
      "@kine/exercise-library": ["../../packages/exercise-library/src/index.ts"],
