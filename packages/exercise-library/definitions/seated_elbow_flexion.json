    "status": "draft"
  },
  "camera": {
    "view": "front",
    "distanceM": 1.8,
    "height": "seated_chest",
    "setupCueKey": "cue.setup_seated_front"
  },
  "requiredParts": [
    "shoulder",
    "elbow",
    "wrist"
  ],
  "side": "auto",
  "signal": {
    "type": "jointAngle",
    "joint": "elbow"
  },
  "rep": {
    "enterDeg": 70,
    "exitDeg": 130,
    "minHoldMs": 200,
    "minDurationMs": 1000,
    "maxDurationMs": 10000
  },
  "rom": {
    "goalPeakDeg": 30,
    "minAcceptablePeakDeg": 60
  },
  "tempo": {
    "idealMs": 3000
  },
  "formRules": [
    {
      "id": "elbow_drift",
      "type": "landmarkDrift",
      "part": "elbow",
      "axis": "x",
      "maxDelta": 0.06,
      "cueKey": "cue.keep_elbows_in",
      "severity": "info",
      "debounceMs": 600,
      "cooldownMs": 8000
    }
  ],
  "safety": {
